# .env.example — modèle des variables serveur (API Vercel).
# Copier en .env.local pour `vercel dev`.
# Sur Vercel : Project Settings → Environment Variables.

# Supabase (création des comptes)
SUPABASE_URL=https://vdvziuzlpnkmmnesonht.supabase.co
SUPABASE_SECRET_KEY=votre_cle_secrete_supabase

# Stripe (vérification du paiement + webhook)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe
# Webhook (Stripe Dashboard → Developers → Webhooks → Add endpoint)
# URL : https://VOTRE_DOMAINE/api/stripe-webhook
# Événements à cocher :
#   - customer.subscription.updated
#   - customer.subscription.deleted
#   - invoice.payment_failed
# Astuce Payment Links : pour limiter les doublons de customer, activez
# « Limit customers to one subscription / reuse customers by email » si dispo.
STRIPE_WEBHOOK_SECRET=whsec_optionnel

# Resend (envoi des mails d’identifiants)
RESEND_API_KEY=re_votre_cle_resend
RESEND_FROM_EMAIL=Nolimi <onboarding@resend.dev>

# Lien affiché dans le mail (optionnel, défaut : https://nolimi.net)
NOLIMI_SITE_URL=https://nolimi.net
